# ── Server environment configuration (rename to `.env` and fill values) ─
# SECURITY: This file documents every secret the backend needs. Copy to
# `.env` and fill with real values. `.env` is gitignored and NEVER bundled
# into the frontend. No value here is ever shipped to the browser.
# The CRM provider credentials are injected server-side only.

# ── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Origin(s) allowed to call the API (CORS). Comma-separated. NEVER use "*" in production.
CORS_ORIGIN=http://localhost:5173,https://preview-*.vibepreview.com
# Provider mode: true = MockProvider (dev), false = GhlProvider (prod).
USE_MOCK=true

# ── Cache / Rate limiting (production) ────────────────────────────────
# Redis URL for shared rate-limiting + webhook idempotency across instances.
REDIS_URL=

# ── Auth / Crypto ──────────────────────────────────────────────────────
# Used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
# 32-byte hex key for encrypting stored provider tokens at rest.
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# ── Database ───────────────────────────────────────────────────────────
# Postgres connection string (or sqlite for local dev). The repositories
# are written against a generic interface; swap the implementation per env.
DATABASE_URL=postgresql://user:password@localhost:5432/salesos

# ── CRM Provider (Private API v2.0) ────────────────────────────────────
# DEFAULT provider credentials. In multi-tenant mode each tenant stores its
# own token (encrypted) — these are the bootstrap/fallback.
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_PRIVATE_API_TOKEN=
# Default location/subaccount. Per-tenant config overrides this.
GHL_LOCATION_ID=
# Webhook signature secret shared with the CRM provider.
WEBHOOK_SECRET=

# ── Scheduler (scheduled messages) ────────────────────────────────────
# How often the scheduler polls for due scheduled messages (ms).
SCHEDULER_INTERVAL_MS=30000

# ── AI / Transcription (optional, backend-only) ────────────────────────
# When provided, the call-analysis service transcribes + analyzes calls.
# Never exposed to the frontend.
AI_PROVIDER=none
AI_API_KEY=

# ── Telephony provider (optional, backend-only) ───────────────────────
TELEPHONY_PROVIDER=none
TELEPHONY_API_KEY=
